<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_intro" android:textSize="14sp" />
        <EditText android:id="@+id/url" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:hint="@string/setup_url" android:inputType="textUri" android:text="http://192.168.1.1" />
        <EditText android:id="@+id/user" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/setup_user" android:inputType="text" android:autofillHints="username" />
        <EditText android:id="@+id/pass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/setup_pass" android:inputType="textPassword" android:autofillHints="password" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_stored" android:textSize="12sp" />
        <CheckBox android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/setup_logout" android:checked="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_logout_help" android:textSize="12sp" />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/setup_save" />
        <Button android:id="@+id/forget" style="?android:attr/borderlessButtonStyle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/setup_forget_cert" />
    </LinearLayout>
</ScrollView>
